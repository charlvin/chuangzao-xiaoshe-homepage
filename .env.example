# Chuangzao Xiaoshe Official Site — Environment Variables
#
# Current status: NO environment variables are required to run or build this app.
# The site is a static React SPA; content lives in src/siteData.js and src/App.jsx.
#
# Copy this file to .env.local for local overrides (optional, not needed today):
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to client code.
# Never commit .env or .env.local with real secrets.

# ---------------------------------------------------------------------------
# Future placeholders (uncomment and document when implemented)
# ---------------------------------------------------------------------------

# VITE_ANALYTICS_ID=
#   Purpose: Public analytics measurement ID (e.g. Plausible, GA4)
#   Required: no (not implemented)
#   Secret: no (client-side)

# VITE_API_BASE_URL=
#   Purpose: Backend API base URL if a CMS or contact API is added
#   Required: no (no backend today)
#   Secret: no

# Example server-side only variable (would NOT use VITE_ prefix):
# CONTACT_WEBHOOK_URL=
#   Purpose: Serverless function webhook for form submissions
#   Required: no (not implemented)
#   Secret: yes — set only in Vercel Environment Variables, never in client bundle
